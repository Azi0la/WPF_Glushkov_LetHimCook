<Window x:Class="LetHimCook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LetHimCook"
        mc:Ignorable="d"
        Title="LetHimCook" Height="450" Width="800"
        Closing="Window_Closing">

    <Grid>
        <Frame x:Name="MainFrame"/>

        <Border Width="80" HorizontalAlignment="Left" Background="Transparent">
            <Border x:Name="NavPanel" Background="{DynamicResource SidePanelBrush}" CornerRadius="0,15,15,0" Width="60" HorizontalAlignment="Left">
                <Border.RenderTransform>
                    <TranslateTransform X="-50"/>
                </Border.RenderTransform>
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="HomeButt" Style="{StaticResource IconButton}" Click="MainButt_Click" Tag="1" Margin="0,10,0,10">
                        <Image x:Name="HomeImage" Source="/res/Dark-home.png"/>
                        <Button.ToolTip>
                            <ToolTip>
                                Главная страница
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="EditButt" Style="{StaticResource IconButton}" Click="MainButt_Click" Tag="2" Margin="0,10,0,10">
                        <Image x:Name="EditImage" Source="/res/Dark-edit.png"/>
                        <Button.ToolTip>
                            <ToolTip>
                                Редактор постов
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="AccButt" Style="{StaticResource IconButton}" Click="MainButt_Click" Tag="3" Margin="0,10,0,10">
                        <Image x:Name="AccImage" Source="/res/Dark-user.png"/>
                        <Button.ToolTip>
                            <ToolTip>
                                Аккаунт
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <!--<Button x:Name="ModButt" Style="{StaticResource IconButton}" Click="MainButt_Click" Tag="4" Margin="0,10,0,10" Visibility="Collapsed">
                        <Image x:Name="ModImage" Source="/res/Dark-admin.png"/>
                        <Button.ToolTip>
                            <ToolTip>
                                Модерация
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>-->
                    <Button x:Name="ThemeButt" Style="{StaticResource IconButton}" Click="StyleButton_Click" Tag="5" Margin="0,10,0,10">
                        <Image x:Name="ThemeImage" Source="/res/Dark-settings-sliders.png"/>
                        <Button.ToolTip>
                            <ToolTip>
                                Изменить тему
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                </StackPanel>
            </Border>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Mouse.MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="NavPanel" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                             To="0" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <EventTrigger RoutedEvent="Mouse.MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="NavPanel" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             To="-50" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            
        </Border>
    </Grid>
</Window>
