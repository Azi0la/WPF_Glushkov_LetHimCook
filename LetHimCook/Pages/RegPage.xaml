<Page x:Class="LetHimCook.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LetHimCook.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegPage"
      Background="{DynamicResource WindowBackgroundBrush}">

    <Grid>
        <Border
                Style="{StaticResource Border1}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="275"
                Height="350"
                CornerRadius="15">

            <StackPanel>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="Let Him Cook" FontSize="30"/>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
            Text="Регистрация" FontSize="24" Margin="0,0,0,5"/>
                <WrapPanel HorizontalAlignment="Center">
                    <TextBlock Text="Логин:" FontSize="16"/>
                    <Grid>
                        <TextBox x:Name="LoginTB" Width="225" Height="25" 
                                 ToolTip="Введите логин" 
                                 TextChanged="LoginTB_TextChanged"
                                 GotFocus="LoginTB_GotFocus"
                                 LostFocus="LoginTB_LostFocus"/>
                        <TextBlock x:Name="LoginPlaceholder"
                            Text="Введите логин"
                            Foreground="Gray"
                            VerticalAlignment="Center"
                            Margin="15,0,0,0"
                            IsHitTestVisible="False"
                            Visibility="Visible"/>
                    </Grid>
                </WrapPanel>
                <WrapPanel HorizontalAlignment="Center">
                    <TextBlock Text="Почта:" FontSize="16"/>
                    <Grid>
                        <TextBox x:Name="EmailTB" Width="225" Height="25" 
                             ToolTip="Введите вашу почту" 
                             TextChanged="EmailTB_TextChanged"
                             GotFocus="EmailTB_GotFocus"
                             LostFocus="EmailTB_LostFocus"/>
                        <TextBlock x:Name="EmailPlaceholder"
                            Text="Введите вашу почту"
                            Foreground="Gray"
                            VerticalAlignment="Center"
                            Margin="15,0,0,0"
                            IsHitTestVisible="False"
                            Visibility="Visible"/>  
                    </Grid>
                </WrapPanel>
                <WrapPanel HorizontalAlignment="Center">
                    <TextBlock Text="Пароль:" FontSize="16"/>
                    <Grid>
                        <PasswordBox x:Name="PassTB" Width="225" Height="25" 
                                     ToolTip="Мин. 8 симв., A-z, 0-9, !@#$%^*" 
                                     PasswordChanged="PassTB_PasswordChanged"
                                     GotFocus="PassTB_GotFocus"
                                     LostFocus="PassTB_LostFocus"/>
                        <TextBlock x:Name="PassPlaceholder"
                            Text="Мин. 8 симв., A-z, 0-9, !@#$%^*"
                            Foreground="Gray"
                            FontSize="12"
                            VerticalAlignment="Center"
                            Margin="15,0,0,0"
                            Visibility="Visible"
                            IsHitTestVisible="False"
                            TextWrapping="Wrap"/>
                    </Grid>
                </WrapPanel>
                <WrapPanel HorizontalAlignment="Center">
                    <TextBlock Text="Повтор пароля:" FontSize="16"/>
                    <Grid>
                        <PasswordBox x:Name="PassDubTB" Width="225" Height="25" 
                                     ToolTip="Мин. 8 симв., A-z, 0-9, !@#$%^*" 
                                     PasswordChanged="PassDubTB_PasswordChanged"
                                     GotFocus="PassDubTB_GotFocus"
                                     LostFocus="PassDubTB_LostFocus"/>
                        <TextBlock x:Name="PassDubPlaceholder"
                        Text="Повторите пароль"
                        Foreground="Gray"
                        VerticalAlignment="Center"
                        Margin="15,0,0,0"
                        IsHitTestVisible="False"
                        Visibility="Visible"/>
                    </Grid>
                </WrapPanel>
                <Button x:Name="RegButt" Width="110" Height="30" Content="Регистрация" Margin="10" Click="RegButt_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
