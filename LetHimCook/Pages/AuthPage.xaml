<Page x:Class="LetHimCook.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LetHimCook.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage"
      Background="{DynamicResource WindowBackgroundBrush}">

    <Grid>
        <Border
            Style="{StaticResource Border1}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="275"
            Height="350"
            CornerRadius="15">

            <StackPanel>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="Let Him Cook" FontSize="30"/>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                    Text="Авторизация" FontSize="24" Margin="0,0,0,0"
                           />
                <WrapPanel x:Name="LoginGrid" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="Логин:" FontSize="18"/>
                    <TextBox x:Name="LoginTB" Width="225" Height="30" ToolTip="Введите логин"/>
                </WrapPanel>
                <WrapPanel x:Name="PassGrid" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="Пароль:" FontSize="18"/>
                    <PasswordBox x:Name="PassTB" Width="225" Height="30" ToolTip="Введите пароль"/>
                </WrapPanel>
                <StackPanel x:Name="CaptchaGrid" Visibility="Visible">
                    <TextBlock Text="Подтвердите что вы человек" FontSize="16" HorizontalAlignment="Center" />
                    <TextBox Visibility="Visible" x:Name="Captcha"
                    Height="42" Width="156" TextAlignment="Center"
                    FontStretch="UltraCondensed" IsReadOnly="True" FontSize="20">
                    </TextBox>
                    <TextBox x:Name="CaptchaInput" Visibility="Visible" 
                             Height="34" Width="160"
                             Text="" TextWrapping="Wrap" ToolTip="Введите показанные символы"/>
                    <Button x:Name="CaptchaBTN" Content="Подтвердить" Height="40" Width="110" ToolTip="Проверить введенные символы" Click="CaptchaBTN_Click"/>
                </StackPanel>
                
                <Button x:Name="AuthButt" Width="110" Height="40" Content="Войти" Margin="5" Click="AuthButt_Click"/>
                <Button x:Name="ForgotButt" Width="115" Height="20" Content="Нет аккаунта?" Background="Transparent" Click="ForgotButt_Click"/>
                <Button x:Name="ForgotPassButt" Width="150" Height="20" Content="Забыли пароль?" Background="Transparent" Click="ForgotPassButt_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
