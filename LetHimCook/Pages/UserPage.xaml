<Page x:Class="LetHimCook.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LetHimCook.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UserPage"
      Background="{DynamicResource WindowBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1.5*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Column="1" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2.5*"/>
                </Grid.ColumnDefinitions>
                <Image Source="{Binding AvatarUrl}" Width="100" Height="100" 
            Margin="10" Grid.Column="0"
            HorizontalAlignment="Left"/>
                <StackPanel VerticalAlignment="Top" Grid.Column="1">
                    <TextBlock Text="{Binding Name, StringFormat=Имя: {0}}" Margin="0,20,0,0" FontSize="20"/>
                    <TextBlock Text="{Binding Email, StringFormat=Почта: {0}}" Margin="0,5,0,0" FontSize="20"/>
                    <TextBlock Text="{Binding Roles.Name, StringFormat=Роль: {0}}" Margin="0,5,0,0" FontSize="20"/>
                    <TextBlock Text="{Binding Bio, StringFormat=Био: {0}}" Margin="0,5,0,0" FontSize="20"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <Button x:Name="ChangePassBTN" Content="Смена пароля"  Click="ChangePassBTN_Click"/>
                <Button x:Name="ChangeAvatarBTN" Content="Смена аватара" Click="ChangeAvatarBTN_Click"/>
                <Button x:Name="RedactBioBTN" Content="Смена Био" Click="RedactBioBTN_Click"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Grid.Row="1">
                <Button x:Name="LeaveBTN" Content="Выйти из аккаунта" Click="LeaveBTN_Click"/>
                <Button x:Name="DelBTN" Content="Удалить" Click="DelBTN_Click" Margin="10" IsEnabled="False"/>
            </StackPanel>
            
        </Grid>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="8*"/>
            </Grid.RowDefinitions>

            <Label Content="Ваши рецепты" HorizontalAlignment="Center" FontSize="20" Grid.Row="0"></Label>
            <ListBox x:Name="HistoryList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}"
                     SelectionChanged="HistoryList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Image Source="{Binding MainImage}" 
                               Height="90" 
                               Stretch="UniformToFill"
                               Margin="0,0,0,6"/>


                            <TextBlock Text="{Binding Title}" 
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   MaxHeight="40"
                                   TextTrimming="CharacterEllipsis"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding Rating, StringFormat= Оценка: {0}}" 
                                       FontSize="12"/>
                                <TextBlock Text="{Binding CookingTime, StringFormat= Время: {0}}" 
                                       FontSize="12"
                                       Foreground="Gray"
                                       Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Stretch" Orientation="Vertical">
                        </WrapPanel>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Grid>
    </Grid>
</Page>
