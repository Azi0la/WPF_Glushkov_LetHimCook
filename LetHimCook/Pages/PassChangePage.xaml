<Page x:Class="LetHimCook.Pages.PassChangePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LetHimCook.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PassChangePage"
      Background="{DynamicResource WindowBackgroundBrush}">

    <Grid>
        <Border
        Style="{StaticResource Border1}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Width="275"
        Height="350"
        CornerRadius="15">

            <StackPanel>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
           Text="Смена пароля" FontSize="30" Margin="0,0,0,20"/>
                <WrapPanel HorizontalAlignment="Center">
                    <TextBlock Text="Старый пароль:" FontSize="16"/>
                    <Grid>
                        <PasswordBox x:Name="OldPassTB" Width="225" Height="25" 
                         ToolTip="Введите ваш старый пароль" 
                         PasswordChanged="OldPassTB_PasswordChanged"
                         GotFocus="OldPassTB_GotFocus"
                         LostFocus="OldPassTB_LostFocus"/>
                        <TextBlock x:Name="OldPassPlaceholder"
                    Text="Введите ваш прошлый пароль"
                    Foreground="Gray"
                    VerticalAlignment="Center"
                    Margin="15,0,0,0"
                    IsHitTestVisible="False"
                    Visibility="Visible"/>
                    </Grid>
                </WrapPanel>
                <WrapPanel HorizontalAlignment="Center">
                    <TextBlock Text="Пароль:" FontSize="16"/>
                    <Grid>
                        <PasswordBox x:Name="NewPassTB" Width="225" Height="25" 
                             ToolTip="Мин. 8 симв., A-z, 0-9, !@#$%^*" 
                             PasswordChanged="NewPassTB_PasswordChanged"
                             GotFocus="NewPassTB_GotFocus"
                             LostFocus="NewPassTB_LostFocus"/>
                        <TextBlock x:Name="NewPassPlaceholder"
                    Text="Мин. 8 симв., A-z, 0-9, !@#$%^*"
                    Foreground="Gray"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Margin="15,0,0,0"
                    Visibility="Visible"
                    IsHitTestVisible="False"
                    TextWrapping="Wrap"/>
                    </Grid>
                </WrapPanel>
                <WrapPanel HorizontalAlignment="Center">
                    <TextBlock Text="Повтор пароля:" FontSize="16"/>
                    <Grid>
                        <PasswordBox x:Name="NewPassDubTB" Width="225" Height="25" 
                             ToolTip="Мин. 8 симв., A-z, 0-9, !@#$%^*" 
                             PasswordChanged="NewPassDubTB_PasswordChanged"
                             GotFocus="NewPassDubTB_GotFocus"
                             LostFocus="NewPassDubTB_LostFocus"/>
                        <TextBlock x:Name="NewPassDubPlaceholder"
                Text="Повторите пароль"
                Foreground="Gray"
                VerticalAlignment="Center"
                Margin="15,0,0,0"
                IsHitTestVisible="False"
                Visibility="Visible"/>
                    </Grid>
                </WrapPanel>
                <Button x:Name="ChangePassButt" Width="150" Height="30" Content="Сменить пароль" Margin="10" Click="ChangePassButt_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
